# BigWigs packager settings (used by .github/workflows/release.yml).
# The addon lives in the AssistCompanion/ subfolder: move it to the top of the zip and
# leave the repository's docs, tools and tests out.
package-as: AssistCompanion

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

move-folders:
  AssistCompanion/AssistCompanion: AssistCompanion

ignore:
  - docs
  - tools
  - tests
  - README.md
  - CHANGELOG.md
